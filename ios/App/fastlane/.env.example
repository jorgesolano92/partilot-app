# Copia este archivo a ".env" y rellena los valores.
# NO subas el ".env" ni el fichero .p8 al repositorio (ya están en .gitignore).

# --- App Store Connect API Key ---
# Crea la clave en: App Store Connect > Users and Access > Integrations > App Store Connect API
# (rol "App Manager" o superior). Descarga el fichero AuthKey_XXXX.p8 (solo se descarga una vez).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8

# --- match ---
# URL del repositorio Git PRIVADO donde match guarda los certificados cifrados.
MATCH_GIT_URL=git@github.com:tu-org/partilot-certs.git
# Contraseña que cifra el contenido del almacén (invéntala y guárdala en un gestor de contraseñas).
MATCH_PASSWORD=una-contraseña-larga-y-secreta
